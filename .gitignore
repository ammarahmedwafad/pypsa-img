# --- Checkpoints and solver artefacts -------------------------------------
# Monte Carlo and carbon-price-sweep checkpoints are regenerated by running the
# notebook. The small trade-off checkpoint may be committed deliberately for
# instant reproducibility; if so, force-add it (git add -f) since this rule
# would otherwise exclude it.
*.pkl
mc_checkpoints/
tradeoff_checkpoints/
*.lp
*.sol

# --- Credentials and secrets ----------------------------------------------
# The Copernicus Climate Data Store API key must never be committed.
.cdsapirc
*.env
.env

# --- User-obtained input data ---------------------------------------------
# Demand profile and downloaded ERA5 files are obtained by the user (see README).
*.nc
*.grib
demand_*.csv

# --- Generated outputs ----------------------------------------------------
# Figures and tables are regenerated by the notebook. Committed publication
# figures, if any, live under figures/ and can be force-added.
*_full.csv
*_table.csv
tradeoff_*.csv

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# --- OS / editor ----------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
